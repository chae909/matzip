<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kosa.matzip.mapper.ReviewMapper">
  <!-- 결과 매핑 설정 -->
  <resultMap id="ReviewMap" type="Review">
    <id column="id" property="id"/>
    <result column="restaurant_id" property="restaurant_id"/>
    <result column="content" property="content"/>
    <result column="score" property="score"/>
    <result column="created_at" property="created_at"/>
  </resultMap>


  <!-- 단일 항목 조회 -->
  <select id="selectById" resultType="Review">
    SELECT *
    FROM Review
    WHERE id = #{id}
  </select>

  <select id="selectByRestaurantId" resultType="Review">
    SELECT *
    FROM Review
    WHERE restaurant_id = #{id}
  </select>

  <!-- 모든 항목 조회 -->
  <select id="selectAll" resultType="Review">
    SELECT *
    FROM Review

  </select>

  <!-- 항목 추가 -->
  <insert id="insert" parameterType="Review" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO Review (
      restaurant_id,
      content,
      score,
      created_at
    )
    VALUES (
             #{restaurant_id},
             #{content},
             #{score},
             NOW()
           )
  </insert>

  <!-- 항목 수정 -->
  <update id="updateById" parameterType="Review">
    UPDATE Review
    <set>
      <if test="restaurant_id != null">
        restaurant_id = #{restaurant_id},
      </if>
      <if test="content != null">
        content = #{content},
      </if>
      <if test="score != null">
        score = #{score},
      </if>
      created_at = NOW()
    </set>
    WHERE id = #{id}
  </update>

  <!-- 항목 삭제 -->
  <delete id="deleteById" parameterType="INT">
    DELETE FROM Review
    WHERE id = #{id}
  </delete>
</mapper>