<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kosa.matzip.mapper.MenuMapper">
  <!-- 결과 매핑 설정 -->
  <resultMap id="ReviewMap" type="Review">
    <id column="id" property="id"/>
    <result column="restaurant_id" property="restaurant_id"/>
    <result column="content" property="content"/>
    <result column="score" property="score"/>
    <result column="created_at" property="created_at"/>
  </resultMap>


  <select id="findByRestaurantId" parameterType="int" resultType="Menu">
    SELECT * FROM menu WHERE restaurant_id = #{restaurant_id}
  </select>


  <insert id="insert" parameterType="Menu">
    INSERT INTO menu (restaurant_id, name, price, created_at, updated_at)
    VALUES (#{restaurant_id}, #{name}, #{price}, NOW(), NOW())
  </insert>


</mapper>