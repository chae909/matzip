<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kosa.matzip.mapper.RestaurantMapper">
  <!-- 결과 매핑 설정 -->
  <resultMap id="RestaurantMap" type="Restaurant">
    <id column="id" property="id"/>
    <result column="name" property="name"/>
    <result column="address" property="address"/>
    <result column="created_at" property="created_at"/>
    <result column="updated_at" property="updated_at"/>
  </resultMap>

  <!-- 단일 항목 조회 -->
  <select id="selectById" resultType="Restaurant">
    SELECT *
    FROM Restaurant
    WHERE id = #{id}
  </select>

  <!-- 모든 항목 조회 -->
  <select id="selectAll" resultType="Restaurant">
    SELECT *
    FROM Restaurant
  </select>

  <!-- 항목 추가 -->
  <insert id="insert" parameterType="Restaurant" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO Restaurant (
      name,
      address,
      created_at,
      updated_at
    )
    VALUES (
             #{name},
             #{address},
             NOW(),
             NOW()
           )
  </insert>

  <!-- 항목 수정 -->
  <update id="updateById" parameterType="Restaurant">
    UPDATE Restaurant
    <set>
      <if test="name != null">
        name = #{name},
      </if>
      <if test="address != null">
        address = #{address},
      </if>
      updated_at = NOW()
    </set>
    WHERE id = #{id}
  </update>

  <!-- 항목 삭제 -->
  <delete id="deleteById" parameterType="INT">
    DELETE FROM Restaurant
    WHERE id = #{id}
  </delete>
</mapper>